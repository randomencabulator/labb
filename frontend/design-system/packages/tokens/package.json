{
  "name": "@labb/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "labb's design tokens: reference and system colours, type, spacing, radii, shadows and motion, from Design Tokens JSON.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/css.ts",
    "./tokens.css": "./generated/tokens.css",
    "./tokens/*": "./tokens/*"
  },
  "scripts": {
    "build": "node --experimental-strip-types --no-warnings scripts/build.ts",
    "check": "node --experimental-strip-types --no-warnings scripts/build.ts --check",
    "watch": "node --experimental-strip-types --no-warnings scripts/build.ts --watch"
  }
}
